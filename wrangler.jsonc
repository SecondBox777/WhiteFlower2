{
  "name": "whiteflower2",
  "main": "src/index.js",
  "compatibility_date": "2026-09-09",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "keep_vars": true,
  "vars": {
    "OPENAI_MODEL": "gpt-6-sol",
    "TESTING_PAUSED": "true"
  }
}
